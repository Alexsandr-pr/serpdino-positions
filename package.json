{
  "name": "@alexsandr-pr/serpdino-positions",
  "version": "0.1.0",
  "description": "Show SerpDino Google rank tracking positions in your own site's admin. Server-side API client, a ready Next.js page and an optional Basic Auth guard.",
  "keywords": [
    "serpdino",
    "rank-tracker",
    "serp",
    "seo",
    "keyword-positions",
    "nextjs"
  ],
  "license": "MIT",
  "author": "Alexsandr-pr",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18.17"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexsandr-pr/serpdino-positions.git"
  },
  "homepage": "https://github.com/Alexsandr-pr/serpdino-positions#readme",
  "bugs": {
    "url": "https://github.com/Alexsandr-pr/serpdino-positions/issues"
  }
}
